FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY BE/src/ BE/src/
COPY BE/assets/ BE/assets/
RUN dotnet publish BE/src/API/OnePortal.API.csproj -c Release -o /publish/api /p:UseAppHost=false
RUN dotnet publish BE/src/Gateway/OnePortal.Gateway.csproj -c Release -o /publish/gateway /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /publish/ /app/
COPY scripts/start-oneportal-render-free.sh /app/start.sh
RUN sed -i 's/\r$//' /app/start.sh && chmod +x /app/start.sh
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080
ENTRYPOINT ["/bin/bash", "/app/start.sh"]
