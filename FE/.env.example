# ==========================================
# CẤU HÌNH MÔI TRƯỜNG FRONTEND (REACT / VITE)
# Copy file này thành .env và điền các giá trị thực tế
# ==========================================

# 1. Địa chỉ Backend Web API (.NET 10)
# Khi chạy Local:
VITE_API_BASE_URL=http://localhost:54611/api/v1
# Khi chạy Production (Render):
# VITE_API_BASE_URL=https://templatelandingpage.onrender.com/api/v1

# 2. Supabase Auth SDK (Dùng cho Google & Facebook OAuth PKCE)
# URL Supabase Project:
VITE_SUPABASE_URL=https://womdjbjgsnokbntdidoc.supabase.co
# Anon Public Key / Publishable Key (Lấy tại Supabase Dashboard -> Project Settings -> API):
# Hỗ trợ cả 2 biến VITE_SUPABASE_ANON_KEY hoặc VITE_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
# Hoặc sử dụng định dạng Publishable Key mới:
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
