{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "ready": {
        "ClusterId": "platform",
        "Order": 0,
        "Match": { "Path": "/health/ready", "Methods": ["GET"] }
      },
      "auth": {
        "ClusterId": "platform",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/auth/{**remainder}"
        },
        "RateLimiterPolicy": "auth"
      },
      "platform": {
        "ClusterId": "platform",
        "Match": {
          "Path": "/api/v1/platform/{**remainder}"
        },
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "api"
      },
      "exports": {
        "ClusterId": "quoting",
        "Order": 0,
        "Match": {
          "Path": "/t/{tenantKey}/api/v1/quoting/quotations/{quotationId}/export",
          "Methods": [
            "POST"
          ]
        },
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "exports"
      },
      "landing": {
        "ClusterId": "landing",
        "Match": {
          "Path": "/t/{tenantKey}/api/v1/landing/{**remainder}"
        },
        "RateLimiterPolicy": "api"
      },
      "quoting": {
        "ClusterId": "quoting",
        "Match": {
          "Path": "/t/{tenantKey}/api/v1/quoting/{**remainder}"
        },
        "RateLimiterPolicy": "api"
      },
      "legacy": {
        "ClusterId": "platform",
        "Order": 100,
        "Match": {
          "Path": "/api/v1/{**remainder}"
        },
        "RateLimiterPolicy": "api"
      }
    },
    "Clusters": {
      "platform": {
        "Destinations": {
          "backend": {
            "Address": "http://127.0.0.1:54611/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        }
      },
      "landing": {
        "Destinations": {
          "backend": {
            "Address": "http://127.0.0.1:54611/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        }
      },
      "quoting": {
        "Destinations": {
          "backend": {
            "Address": "http://127.0.0.1:54611/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        }
      }
    }
  }
}
